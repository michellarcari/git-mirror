{
  "topicPrefix": "git-mirror/v1",
  "repositories": [
    {
      "id": "myapp",
      "url": "git@github.enterprise.example:team/myapp.git",
      "branches": [
        "main",
        "develop",
        "release/*"
      ],
      "mirrorPath": "C:/git-mirror/data/myapp.git"
    }
  ],
  "clients": [
    {
      "id": "server-a",
      "repositories": [
        "myapp"
      ],
      "uploadBaseUrl": "https://server-a.example.com/git-mirror/",
      "tokenEnv": "SERVER_A_UPLOAD_TOKEN"
    }
  ]
}
