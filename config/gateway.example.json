{
  "topicPrefix": "git-mirror/v1",
  "repositories": [
    {
      "id": "myapp",
      "url": "https://github.enterprise.example/team/myapp.git",
      "branch": "main",
      "mirrorPath": "/var/lib/git-mirror/source/myapp.git"
    }
  ],
  "clients": [
    {
      "id": "server-a",
      "repositories": ["myapp"],
      "uploadBaseUrl": "https://server-a.example.com/git-mirror/",
      "tokenEnv": "SERVER_A_UPLOAD_TOKEN"
    }
  ]
}
