# Copy to .env on each server and provide real values. Never commit .env.
# Shared MQTT connection (TLS recommended)
MQTT_URL=mqtts://broker.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Gateway (Windows): set CONFIG_PATH to config/gateway.json
# Use unique tokens for every configured client.
CONFIG_PATH=config/gateway.json
MIRROR_NODE_ID=gateway
STAGING_UPLOAD_TOKEN=
PRODUCTION_UPLOAD_TOKEN=
HUB_UPLOAD_TOKEN=

# Client (Linux): replace the gateway CONFIG_PATH and MIRROR_NODE_ID above
# with config/client.json and the matching clientId. The client's token
# must match its corresponding *_UPLOAD_TOKEN value on the gateway.
# UPLOAD_TOKEN=
